  "logTypes": {
    "apache_access": {
      "category": "web",
      "description": "Apache HTTP Server access logs",
      "filenames": ["access.log", "access_log", "httpd-access.log"],
      "directories": ["/var/log/apache2", "/var/log/httpd", "/usr/local/apache2/logs"],
      "siem": {
        "splunk": {
          "sourcetype": "access_combined",
          "index": "web",
          "app": "Splunk_TA_apache"
        },
        "elastic": {
          "module": "apache",
          "fileset": "access",
          "index": "logs-apache.access-*"
        },
        "sentinel": {
          "table": "ApacheHTTPServer_CL",
          "connector": "Syslog via AMA"
        },
        "qradar": {
          "logSourceType": "Apache HTTP Server",
          "dsm": "Apache"
        },
        "cribl": {
          "sourcetype": "apache:access",
          "pack": "apache"
        }
      }
    },
    "apache_error": {
      "category": "web",
      "description": "Apache HTTP Server error logs",
      "filenames": ["error.log", "error_log", "httpd-error.log"],
