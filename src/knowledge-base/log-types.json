{
  "$schema": "./schemas/log-types.schema.json",
  "$meta": {
    "version": "1.0.0",
    "lastUpdated": "2025-12-04",
    "sources": [
      "https://splunkbase.splunk.com/app/1621",
      "https://www.elastic.co/guide/en/beats/filebeat/current/exported-fields-ecs.html",
